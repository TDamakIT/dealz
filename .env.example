# Copier ce fichier en .env puis remplir les valeurs.  cp .env.example .env

# --- Base de données WordPress (mots de passe locaux, au choix) ---
DB_PASSWORD=change-moi-db
DB_ROOT_PASSWORD=change-moi-root

# --- WordPress ---
WP_PORT=8080
# Adresse du site vue depuis ton navigateur (IP de la VM si tu ouvres depuis Windows)
WP_PUBLIC_URL=http://localhost:8080
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change-moi-admin
WP_ADMIN_EMAIL=admin@dealz.local

# --- Accès des agents à WooCommerce (rempli automatiquement par scripts/setup_wordpress.sh) ---
# Mot de passe d'application WordPress de l'utilisateur admin (pas son vrai mot de passe)
WOO_USER=admin
WOO_APP_PASSWORD=

# --- Agents ---
AGENTS_PORT=8000
# Jeton partagé entre WordPress et le service d'agents (mets une longue chaîne aléatoire)
AGENTS_API_TOKEN=change-moi-token
# Fuseau des tâches planifiées
TZ=Africa/Tunis

# --- Claude (API Anthropic) ---
# Laisser vide = mode simulation : les agents tournent sans appeler l'IA.
ANTHROPIC_API_KEY=
# Budget mensuel en dollars : au-delà, les agents passent en mode simulation et t'alertent.
LLM_BUDGET_USD=20
MODEL_FAST=claude-haiku-5-5
MODEL_SMART=claude-sonnet-5-5

# --- Telegram (alertes) ---
# Créer le bot avec @BotFather, puis lancer : python3 scripts/telegram_chat_id.py
TELEGRAM_BOT_TOKEN=
# Un ou plusieurs identifiants séparés par des virgules (toi, groupe famille…)
TELEGRAM_CHAT_IDS=

# --- Veille prix ---
VEILLE_HEURE=06:30
VEILLE_DELAI_SECONDES=1.5
# Écart (%) au-delà duquel un prix Dealz au-dessus du marché déclenche une alerte
SEUIL_PRIX_ALERTE_PCT=8
# Seuils catalogue
SEUIL_MARGE_PCT=25
SEUIL_STOCK_BAS=20

# --- Agent SEO ---
# 1 = l'agent modifie lui-même les fiches (sauvegarde + /seo_annuler), 0 = il propose sans appliquer
SEO_AUTO=1
# Nombre maximum de fiches modifiées par passage (un passage par nuit à 03:00)
SEO_MAX_PAR_PASSAGE=10

# --- Agent Prospection (recherche web de l'API Claude : à autoriser dans la console Anthropic) ---
WEB_SEARCH_TOOL=web_search_20260209
# Recherches web max par segment (2 segments par jour) : 5 → au plus 10 recherches/jour ≈ 0,10 $
PROSPECTION_RECHERCHES_MAX=5
PROSPECTION_RESULTATS_MAX=8

# --- Experts Tendances et Sourcing Chine ---
# Pages concurrentes suivies : data/tendances_sources.json (vérifier : python -m dealz.tools.check_sources)
# Hypothèses d'import (change, fret, droits, TVA…) : data/import_params.json — À METTRE À JOUR, à confirmer avec un transitaire
SOURCING_RECHERCHES_MAX=5
SOURCING_QTE_DEFAUT=300

# --- Liens entre agents ---
# 0 avant le lancement : les liens qui dépendent de NOS ventes (rupture proche, nos ventes → Tendances) restent en veille.
# Passer à 1 quand les vraies commandes arrivent.
LIENS_VENTES=0
